{
  "name": "taptone",
  "version": "1.0.0",
  "description": "Ultra-lightweight, zero-dependency synthesized Web Audio & Web Haptics micro-library for web UI feedback with 0KB downloaded audio assets.",
  "main": "./dist/taptone.umd.js",
  "module": "./dist/taptone.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/taptone.mjs",
      "require": "./dist/taptone.umd.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --mode library",
    "preview": "vite preview"
  },
  "keywords": [
    "audio",
    "web-audio-api",
    "sound-effects",
    "haptics",
    "micro-sound",
    "ui-sound",
    "synthesizer",
    "tactile",
    "vibration",
    "react",
    "zero-dependency"
  ],
  "author": "fullstackusama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullstackusama/taptone.git"
  },
  "bugs": {
    "url": "https://github.com/fullstackusama/taptone/issues"
  },
  "homepage": "https://github.com/fullstackusama/taptone#readme",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
